# ============================================================
# 神探 SaaS - Web 服务环境变量配置
# 复制此文件为 .env 并填写实际值
# ============================================================

# 运行环境
NODE_ENV=production

# Web 服务端口
PORT=7000

# 应用 ID
VITE_APP_ID=tg-monitor-tdlib

# 数据库连接（MySQL）
DATABASE_URL=mysql://root:YOUR_DB_PASSWORD@127.0.0.1:3306/shentanbot

# MySQL Socket 路径（宝塔面板使用 /tmp/mysql.sock）
DB_SOCKET_PATH=/tmp/mysql.sock

# JWT 密钥（用于 Cookie 签名，请使用随机长字符串）
JWT_SECRET=your-jwt-secret-here

# 引擎通信密钥（必须与 monitor-engine/.env 中的 ENGINE_SECRET 保持一致）
ENGINE_SECRET=your-engine-secret-here

# OAuth 服务配置
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://auth.manus.im

# 管理员账号
OWNER_OPEN_ID=admin
OWNER_NAME=Admin

# Forge API 配置
BUILT_IN_FORGE_API_URL=https://api.manus.im
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im

# 登录服务端口
LOGIN_SERVICE_PORT=5051
